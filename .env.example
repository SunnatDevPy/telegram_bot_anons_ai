# ====================================================================
# NeuraTech AI Telegram Bot — Konfiguratsiya Namunasi (.env.example)
# Ushbu fayldan nusxa olib '.env' nomiga o'zgartiring va qiymatlarni to'ldiring.
# ====================================================================

# 1. Telegram Bot va Rasmiy Kanal Sozlamalari (Majburiy)
# @BotFather orqali olingan bot tokeni
BOT_TOKEN=1234567890:ABCDefghIJKLmnOPQRstuvwxyz

# Yangiliklar e'lon qilinadigan Telegram kanal ID raqami (odatda -100 bilan boshlanadi)
CHANNEL_ID=-1002100461506

# Kanal username'i (@ belgisi bilan yoki belgisisiz)
CHANNEL_USERNAME=@neuratech_uz

# Kanal to'liq havolasi
CHANNEL_LINK=https://t.me/neuratech_uz

# Bot username'i (Kanal ostidagi interaktiv tugmalar uchun)
BOT_USERNAME=neuratech_news_bot

# Kanal postlari ostidagi muhokama guruhi havolasi (ixtiyoriy)
DISCUSSION_CHAT_LINK=


# 2. Google Gemini AI Kalitlari (Multi-Key Pool)
# Google AI Studio (https://aistudio.google.com/) orqali bepul olingan API kalitlar.
# Bot bitta kalitga bog'lanib qolmaydi — so'rovlarni Round-Robin usulida taqsimlaydi
# va 429 (kvota tugashi) xatoligi bo'lsa, keyingi kalitga avtomatik o'tadi.
GEMINI_API_KEY=AIzaSy...Asosiy_Kalit
GEMINI_API_KEY_1=AIzaSy...Zaxira_Kalit_1
GEMINI_API_KEY_2=AIzaSy...Zaxira_Kalit_2
GEMINI_API_KEY_3=AIzaSy...Zaxira_Kalit_3

# Vergul bilan ajratilgan qo'shimcha kalitlar ro'yxati (ixtiyoriy)
GEMINI_API_KEYS=


# 3. Bot Boshqaruvi va Rejim Sozlamalari
# Boshqaruvchi adminning Telegram ID raqami (@userinfobot orqali olish mumkin)
ADMIN_ID=5649321700

# Yangiliklarni qidirish va RSS skanerlash oraliq vaqti (daqiqada, standart: 25)
CHECK_INTERVAL_MINUTES=25

# Boshlang'ich nashr rejimi:
# 'moderation' — postlar avval adminga tasdiqlash uchun keladi
# 'auto' — postlar avtomatik navbat bilan kanalga chiqariladi
DEFAULT_MODE=auto


# 4. Anti-Burst (Navbat va Oraliq Nazorati)
# Kanalga ketma-ket xabarlar spam bo'lib tushmasligi uchun postlar orasidagi minimal oraliq (daqiqada, standart: 10)
POST_SPACING_MINUTES=10

# Navbatda ushlab turiladigan maksimal xabarlar soni (standart: 6).
# Navbat to'lsa, eski yangiliklar yig'ilib qolmasligi va AI kvotasi tejalishi uchun yangi xabar olinmaydi.
MAX_SCHEDULED_QUEUE=6


# 5. Kanal Postlari Ostidagi Interaktiv Tugmalar
# Maqolaning original manbasiga o'tish tugmasi (True / False)
ENABLE_CHANNEL_SOURCE_BUTTON=True

# Bot ichidagi AI Maslahatchiga o'tish tugmasi (True / False)
ENABLE_CHANNEL_AI_BUTTON=True


# 6. Avtomatik Zaxiralash (Backup)
# Har kuni bazaning ACID to'liq ZIP nusxasini adminga yuborish vaqti (Toshkent vaqti bilan, standart: 3)
BACKUP_HOUR=3


# 7. Telegram Premium Custom Emoji ID lari (Ixtiyoriy)
# Kanal postlaridagi bo'lim sarlavhalari uchun animatsiyali Telegram Premium emojilari
EMOJI_LIGHTNING=
EMOJI_PIN=
EMOJI_CHART=
EMOJI_BULB=
EMOJI_ANTENNA=
EMOJI_TAG=
